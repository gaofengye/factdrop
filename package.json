{
  "name": "factdrop",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && docker compose up",
    "dev:backend:build": "cd backend && docker compose up --build",
    "dev:frontend": "cd frontend && npx expo start",
    "stop": "cd backend && docker compose down -v"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
